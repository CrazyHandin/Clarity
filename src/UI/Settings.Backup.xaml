<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity" Foreground="#DFEAF2" FontSize="15">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.45*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <local:GlassPanel Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,14,0" VerticalAlignment="Top" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity">
      <StackPanel>
        <TextBlock Text="文件备份" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="备份保存位置" Foreground="#A7BFCD" FontSize="14" Margin="0,14,0,0" />
        <TextBox x:Name="RecoveryPath" Height="38" Margin="0,8,0,12" Padding="9" Background="#25333E" Foreground="#DFEAF2" BorderBrush="#45616C" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        <WrapPanel>
          <Button x:Name="ChooseRecovery" Content="选择目录" Margin="0,0,10,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <Button x:Name="OpenRecovery" Content="打开备份位置" Background="#28524F" BorderBrush="#39C5BB" Foreground="#D7F6F2" Margin="0,0,10,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <Button x:Name="SaveRecovery" Content="保存位置" Margin="0,0,10,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        </WrapPanel>
        <TextBlock Text="建议保存到其他本地磁盘。备份位于 C 盘时，需清空对应备份才会释放空间。" Foreground="#E4BE81" TextWrapping="Wrap" FontSize="14" Margin="0,5,0,0" />
        <Border Height="1" Background="#344651" Margin="0,18,0,18" />
        <TextBlock Text="恢复与管理" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="恢复不会覆盖已有文件；校验成功后自动清除对应备份，未恢复的内容保留。" Foreground="#A7BFCD" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,14" />
        <WrapPanel>
          <Button x:Name="RestoreFiles" Content="恢复文件备份" Background="#39C5BB" Foreground="#083F3A" BorderBrush="#39C5BB" FontWeight="SemiBold" Margin="0,0,10,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <Button x:Name="Purge" Content="清空指定批次" Background="#41372A" Foreground="#E4BE81" BorderBrush="#79613E" Margin="0,0,10,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        </WrapPanel>
        <TextBlock Text="文件备份仅支持本机、本账户恢复。清空备份后无法再从该批次恢复。" Foreground="#91AAB9" TextWrapping="Wrap" FontSize="14" Margin="0,5,0,0" />
      </StackPanel>
    </local:GlassPanel>
    <local:GlassPanel Grid.Column="1" Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="16" Padding="22" VerticalAlignment="Top" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity">
      <StackPanel>
        <TextBlock Text="注册表备份" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="恢复清理前备份的缺失注册表项，保留现有项目。" Foreground="#A7BFCD" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,14" />
        <Button x:Name="RestoreRegistry" Content="恢复注册表备份" HorizontalAlignment="Left" Margin="0,0,0,12" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        <Button x:Name="OpenRegistryBackup" Content="打开注册表备份位置" HorizontalAlignment="Left" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
      </StackPanel>
    </local:GlassPanel>
  </Grid>
</ScrollViewer>
</UserControl>