<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity" Foreground="#DFEAF2" FontSize="15">
<UserControl.Resources><Style TargetType="ListBoxItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <Setter Property="Foreground" Value="#CFDFEB" />
  <Setter Property="Padding" Value="8,5" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ItemSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="3,2" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
          <ContentPresenter />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="ItemSurface" Property="Background" Value="#28524F" />
            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#39C5BB" />
            <Setter Property="Foreground" Value="#E0FAF7" />
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="ItemSurface" Property="Background" Value="#2B424A" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style></UserControl.Resources><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <StackPanel Margin="18">
    <local:GlassPanel Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="16" Padding="22" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="220" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <TextBlock Text="已发现应用" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="OpenApplication" Content="打开应用文件位置" IsEnabled="False" HorizontalAlignment="Right" Background="#28524F" Foreground="#D7F6F2" BorderBrush="#39C5BB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        </Grid>
        <TextBox x:Name="AppSearch" Grid.Row="1" Height="36" Padding="8" Margin="0,12,0,12" Background="#25333E" Foreground="#DFEAF2" BorderBrush="#45616C" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        <ListBox x:Name="Apps" Grid.Row="2" Background="#1D2933" Foreground="#CFDFEB" BorderBrush="#344651" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="7">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="{Binding Publisher}" Foreground="#9EB6C4" FontSize="14" />
                <TextBlock Text="{Binding Executable}" Foreground="#89A6B8" FontSize="14" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBox x:Name="AppEvidence" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="105" VerticalScrollBarVisibility="Auto" Background="#25333E" Foreground="#BBD2DE" BorderThickness="0" Margin="0,12,0,0" Padding="9" FontSize="14" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
      </Grid>
    </local:GlassPanel>
    <local:GlassPanel Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,14,0,0" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity">
      <Expander x:Name="PortableExpander" IsExpanded="False" Foreground="#DFEAF2" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Expander.Header>
          <TextBlock Text="便携 / 自定义软件目录" FontSize="16" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel>
          <ListBox x:Name="Portable" Background="#1D2933" Foreground="#CFDFEB" BorderBrush="#344651" Height="86" Margin="0,12,0,12" />
          <WrapPanel>
            <Button x:Name="AddPortable" Content="添加目录" Margin="0,0,10,8" />
            <Button x:Name="RemovePortable" Content="移除所选" Margin="0,0,10,8" />
          </WrapPanel>
          <TextBlock Text="目录修改自动保存，常规扫描时生效；快速扫描仅使用内置规则。" Foreground="#91AAB9" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Expander>
    </local:GlassPanel>
  </StackPanel>
</ScrollViewer>
</UserControl>