<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity" Foreground="#DFEAF2" FontSize="15" local:UiInput.PreventWheelSelection="True">
  <local:GlassBackdrop Background="#161D25">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="SettingsBack" Content="← 返回清理" Margin="0,0,18,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Border Background="#244C49" CornerRadius="13" Width="48" Height="48" Margin="0,0,14,0">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#39C5BB" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="Heading" Text="设置与备份" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="管理备份、扫描目录与清理规则" Foreground="#9DB5C3" FontSize="14" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="2" x:Name="AboutButton" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="关于 Clarity" />
            <Ellipse x:Name="AboutBadge" Width="8" Height="8" Fill="#F27777" Visibility="Collapsed" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>
      <TabControl x:Name="RulesTabs" Grid.Row="1" Margin="0,20,0,0" BorderBrush="#344651" Foreground="#DFEAF2" SelectedIndex="0">
        <TabItem x:Name="GeneralTab" Header="常规设置">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18">
              <local:GlassPanel Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                  <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="界面主题" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="选择应用的外观主题" Foreground="#9DB5C3" FontSize="13" Margin="0,6,0,0"/></StackPanel>
                    <local:ThemeSelector x:Name="ThemeChoice" Grid.Column="1" VerticalAlignment="Center"/>
                  </Grid>
                  <Border Height="1" Background="#344651" Opacity="0.65" Margin="0,20"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><CheckBox x:Name="LiquidGlassChoice" Content="液态玻璃外观（Beta）" FontSize="17" FontWeight="SemiBold" ToolTip="全透式透出桌面；内部通透仅展示软件内的通透效果。"/><TextBlock Text="实验性外观：让面板呈现柔和的半透明效果。" Foreground="#9DB5C3" FontSize="13" Margin="0,8,0,0"/></StackPanel>
                    <ComboBox x:Name="GlassModeChoice" Grid.Column="1" Height="40" Width="190" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock x:Name="GlassPerformanceNote" Text="该效果会占用显卡资源，可能导致卡顿，请确认设备性能足够后再开启。" Foreground="#E8BE58" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                  <Border Height="1" Background="#344651" Opacity="0.65" Margin="0,20"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="界面语言" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="语言修改自动保存，立即生效。" Foreground="#9DB5C3" FontSize="13" Margin="0,6,0,0"/></StackPanel>
                    <ComboBox x:Name="LanguageChoice" Grid.Column="1" Height="40" Width="190" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
              </local:GlassPanel>
              <local:GlassPanel Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="扫描加速" FontSize="18" FontWeight="SemiBold" />
                  <CheckBox x:Name="ScanCacheChoice" Content="启用本地扫描缓存" Margin="0,12,0,10" />
                  <TextBlock Text="复用已识别信息，加快再次扫描。仅保存在本机，可随时清除。" Foreground="#A7BFCD" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />
                  <Button x:Name="ClearScanCache" Content="清除扫描缓存" HorizontalAlignment="Left" />
                </StackPanel>
              </local:GlassPanel>
              <local:GlassPanel Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="管理员模式" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="PrivilegeState" Foreground="#A7BFCD" FontSize="14" Margin="0,12,0,14" />
                  <Button x:Name="AdminMode" Content="以管理员身份重新启动" HorizontalAlignment="Left" Background="#3B3323" Foreground="#FFE6A3" BorderBrush="#E8BE58" FontWeight="SemiBold" />
                  <TextBlock Text="重启后仍需手动扫描。" Foreground="#91AAB9" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
              </local:GlassPanel>
              <local:GlassPanel Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="清理记录" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock x:Name="HistoryLocation" Foreground="#A7BFCD" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,12" />
                  <WrapPanel>
                    <Button x:Name="OpenHistory" Content="打开清理记录" Margin="0,0,10,0" />
                    <Button x:Name="OpenHistoryFolder" Content="打开记录文件夹" />
                  </WrapPanel>
                </StackPanel>
              </local:GlassPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="BackupTab" Header="备份与恢复" />
        <TabItem x:Name="ApplicationsTab" Header="扫描与应用" />
        <TabItem x:Name="RulesTab" Header="规则管理" />
      </TabControl>
      <local:GlassPanel x:Name="SettingsStatusFrame" Grid.Row="2" Visibility="Collapsed" Background="#1D3035" CornerRadius="9" Padding="12,10" Margin="0,14,0,0">
        <TextBlock x:Name="Status" Text="" Foreground="#ADDBD6" FontSize="14" TextWrapping="Wrap" />
      </local:GlassPanel>
    </Grid>
  </local:GlassBackdrop>
</UserControl>
