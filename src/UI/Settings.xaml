<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#DFEAF2" FontSize="15">
 <Grid Background="#161D25"><Grid Margin="24">
  <Grid.Resources>
   <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="#CFDFEB"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="ItemSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="3,2"><ContentPresenter/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#28524F"/><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#39C5BB"/><Setter Property="Foreground" Value="#E0FAF7"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#2B424A"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="SettingsBack" Content="← 返回清理" Margin="0,0,18,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal">
   <Border Background="#244C49" CornerRadius="13" Width="48" Height="48" Margin="0,0,14,0">
    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#39C5BB" VerticalAlignment="Center" HorizontalAlignment="Center"/>
   </Border>
   <StackPanel VerticalAlignment="Center">
    <TextBlock x:Name="Heading" Text="设置与备份" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Text="管理备份、扫描目录与清理规则" Foreground="#9DB5C3" FontSize="14" Margin="0,3,0,0"/>
   </StackPanel>
  </StackPanel><Button Grid.Column="2" x:Name="AboutButton" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="关于 Clarity"/><Ellipse x:Name="AboutBadge" Width="8" Height="8" Fill="#F27777" Visibility="Collapsed" Margin="8,0,0,0"/></StackPanel></Button></Grid>
  <TabControl x:Name="RulesTabs" Grid.Row="1" Margin="0,20,0,0" Background="#1D2933" BorderBrush="#344651" Foreground="#DFEAF2" SelectedIndex="0">
   <TabItem x:Name="GeneralTab" Header="常规设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18">
     <Border Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18">
      <StackPanel>
       <TextBlock Text="界面语言" FontSize="18" FontWeight="SemiBold"/>
       <ComboBox x:Name="LanguageChoice" Height="38" Width="270" HorizontalAlignment="Left" Margin="0,14,0,12"/>
       <TextBlock Text="界面主题" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <ComboBox x:Name="ThemeChoice" Height="38" Width="270" HorizontalAlignment="Left" Margin="0,12,0,12"/>
       <TextBlock Text="语言修改自动保存，立即生效。" Foreground="#A7BFCD" FontSize="14"/>
      </StackPanel>
     </Border>
     <Border Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
      <StackPanel>
       <TextBlock Text="管理员模式" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock x:Name="PrivilegeState" Foreground="#A7BFCD" FontSize="14" Margin="0,12,0,14"/>
       <Button x:Name="AdminMode" Content="以管理员身份重新启动" HorizontalAlignment="Left" Background="#28524F" Foreground="#D7F6F2" BorderBrush="#39C5BB"/>
       <TextBlock Text="重启后仍需手动扫描。" Foreground="#91AAB9" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0"/>
      </StackPanel>
     </Border>
     <Border Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="清理记录" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HistoryLocation" Foreground="#A7BFCD" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,12"/><WrapPanel><Button x:Name="OpenHistory" Content="打开清理记录" Margin="0,0,10,0"/><Button x:Name="OpenHistoryFolder" Content="打开记录文件夹"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="BackupTab" Header="备份与恢复">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid Margin="18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,14,0" VerticalAlignment="Top">
       <StackPanel>
        <TextBlock Text="文件备份" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="备份保存位置" Foreground="#A7BFCD" FontSize="14" Margin="0,14,0,0"/>
        <TextBox x:Name="RecoveryPath" Height="38" Margin="0,8,0,12" Padding="9" Background="#25333E" Foreground="#DFEAF2" BorderBrush="#45616C"/>
        <WrapPanel>
         <Button x:Name="ChooseRecovery" Content="选择目录" Margin="0,0,10,8"/>
         <Button x:Name="OpenRecovery" Content="打开备份位置" Background="#28524F" BorderBrush="#39C5BB" Foreground="#D7F6F2" Margin="0,0,10,8"/>
         <Button x:Name="SaveRecovery" Content="保存位置" Margin="0,0,10,8"/>
        </WrapPanel>
        <TextBlock Text="建议保存到其他本地磁盘。备份位于 C 盘时，需清空对应备份才会释放空间。" Foreground="#E4BE81" TextWrapping="Wrap" FontSize="14" Margin="0,5,0,0"/>
        <Border Height="1" Background="#344651" Margin="0,18,0,18"/>
        <TextBlock Text="恢复与管理" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="恢复不会覆盖已有文件；校验成功后自动清除对应备份，未恢复的内容保留。" Foreground="#A7BFCD" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,14"/>
        <WrapPanel>
         <Button x:Name="RestoreFiles" Content="恢复文件备份" Background="#39C5BB" Foreground="#083F3A" BorderBrush="#39C5BB" FontWeight="SemiBold" Margin="0,0,10,8"/>
         <Button x:Name="Purge" Content="清空指定批次" Background="#41372A" Foreground="#E4BE81" BorderBrush="#79613E" Margin="0,0,10,8"/>
        </WrapPanel>
        <TextBlock Text="文件备份仅支持本机、本账户恢复。清空备份后无法再从该批次恢复。" Foreground="#91AAB9" TextWrapping="Wrap" FontSize="14" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18" VerticalAlignment="Top">
       <StackPanel>
        <TextBlock Text="注册表备份" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="恢复清理前备份的缺失注册表项，保留现有项目。" Foreground="#A7BFCD" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,14"/>
        <Button x:Name="RestoreRegistry" Content="恢复注册表备份" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <Button x:Name="OpenRegistryBackup" Content="打开注册表备份位置" HorizontalAlignment="Left"/>
       </StackPanel>
      </Border>
     </Grid>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="ApplicationsTab" Header="扫描与应用">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="18">
      <Border Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="已发现应用" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="OpenApplication" Content="打开应用文件位置" IsEnabled="False" HorizontalAlignment="Right" Background="#28524F" Foreground="#D7F6F2" BorderBrush="#39C5BB"/></Grid>
        <TextBox x:Name="AppSearch" Grid.Row="1" Height="36" Padding="8" Margin="0,12,0,12" Background="#25333E" Foreground="#DFEAF2" BorderBrush="#45616C"/>
        <ListBox x:Name="Apps" Grid.Row="2" Background="#1D2933" Foreground="#CFDFEB" BorderBrush="#344651">
         <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Publisher}" Foreground="#9EB6C4" FontSize="14"/><TextBlock Text="{Binding Executable}" Foreground="#89A6B8" FontSize="14" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBox x:Name="AppEvidence" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="105" VerticalScrollBarVisibility="Auto" Background="#25333E" Foreground="#BBD2DE" BorderThickness="0" Margin="0,12,0,0" Padding="9" FontSize="14"/>
       </Grid>
      </Border>
      <Border Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
       <Expander x:Name="PortableExpander" IsExpanded="False" Foreground="#DFEAF2">
        <Expander.Header><TextBlock Text="便携 / 自定义软件目录" FontSize="16" FontWeight="SemiBold"/></Expander.Header>
        <StackPanel>
         <ListBox x:Name="Portable" Background="#1D2933" Foreground="#CFDFEB" BorderBrush="#344651" Height="86" Margin="0,12,0,12"/>
         <WrapPanel><Button x:Name="AddPortable" Content="添加目录" Margin="0,0,10,8"/><Button x:Name="RemovePortable" Content="移除所选" Margin="0,0,10,8"/></WrapPanel>
         <TextBlock Text="目录修改自动保存，常规扫描时生效；快速扫描仅使用内置规则。" Foreground="#91AAB9" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
       </Expander>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="RulesTab" Header="规则管理">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="18">
      <Border Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18">
       <StackPanel>
        <TextBlock Text="清理规则来源" FontSize="18" FontWeight="SemiBold"/>
        <ComboBox x:Name="RuleProvider" Margin="0,12,0,10" Height="38"/>
        <TextBlock x:Name="LibraryState" Foreground="#A7BFCD" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock Text="HTTPS 规则文件地址" FontSize="14" Margin="0,18,0,0"/>
        <TextBox x:Name="UpdateUrl" Margin="0,10,0,14" Height="38" Background="#25333E" Foreground="#DFEAF2" BorderBrush="#45616C" Padding="8"/>
        <CheckBox x:Name="Automatic" Content="每 7 天自动检查一次" Margin="0,0,0,16"/>
        <WrapPanel>
         <Button x:Name="Save" Content="保存规则设置" Margin="0,0,10,8"/>
         <Button x:Name="Check" Content="检查更新" Margin="0,0,10,8" Background="#39C5BB" Foreground="#083F3A" BorderBrush="#39C5BB" FontWeight="SemiBold"/>
        </WrapPanel>
       </StackPanel>
      </Border>
      <Border Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
       <StackPanel>
        <TextBlock Text="本地规则与版本管理" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <WrapPanel>
         <Button x:Name="Import" Content="本地导入" Margin="0,0,10,8"/>
         <Button x:Name="Export" Content="导出当前规则" Margin="0,0,10,8"/>
         <Button x:Name="Rollback" Content="回退上一版" Margin="0,0,10,8"/>
         <Button x:Name="Compatibility" Content="兼容报告" Margin="0,0,10,8"/>
         <Button x:Name="JsonGuide" Content="JSON 规则填写说明" Margin="0,0,10,8"/>
        </WrapPanel>
        <TextBlock x:Name="SourceHint" Foreground="#E4BE81" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Border x:Name="SettingsStatusFrame" Grid.Row="2" Visibility="Collapsed" Background="#1D3035" CornerRadius="9" Padding="12,10" Margin="0,14,0,0">
   <TextBlock x:Name="Status" Text="" Foreground="#ADDBD6" FontSize="14" TextWrapping="Wrap"/>
  </Border>
 </Grid></Grid>
</UserControl>
