<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity" Foreground="#DFEAF2" FontSize="15">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <StackPanel Margin="18">
    <TextBlock Text="常规扫描使用已启用的规则，重复文件只处理一次。" Foreground="#A7BFCD" Margin="2,0,0,16" TextWrapping="Wrap" />
    <local:GlassPanel Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="20" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Winapp2 社区规则" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="LibraryState" Foreground="#A7BFCD" Margin="0,8,0,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          </StackPanel>
          <CheckBox x:Name="EnableWinapp2" Grid.Column="1" Content="启用" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        </Grid>
        <TextBox x:Name="UpdateUrl" IsReadOnly="True" Margin="0,18,0,14" Height="38" Background="#25333E" Foreground="#A7BFCD" BorderBrush="#344651" Padding="8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        <CheckBox x:Name="Automatic" Content="每 7 天自动检查一次" Margin="0,0,0,16" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        <WrapPanel>
          <Button x:Name="Check" Content="检查更新" Margin="0,0,10,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <Button x:Name="ImportIni" Content="导入 INI" Margin="0,0,10,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <Button x:Name="ExportIni" Content="导出 INI" Margin="0,0,10,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <Button x:Name="RollbackIni" Content="回退上一版" Margin="0,0,10,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <Button x:Name="Compatibility" Content="兼容报告" Margin="0,0,0,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
        </WrapPanel>
      </StackPanel>
    </local:GlassPanel>
    <local:GlassPanel Background="#202D37" BorderBrush="#344651" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,0" xmlns:local="clr-namespace:ClearSpace;assembly=Clarity">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0">
          <TextBlock Text="JSON 规则库" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="JsonSummary" Foreground="#A7BFCD" Margin="0,8,0,8" TextWrapping="Wrap" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
          <TextBlock Text="一次导入多个文件，每份规则独立启停、更新和回退。" Foreground="#A7BFCD" TextWrapping="Wrap" />
        </StackPanel>
        <Button x:Name="RulePacks" Grid.Column="1" Content="管理 JSON 规则" VerticalAlignment="Center" Background="#39C5BB" Foreground="#083F3A" BorderBrush="#39C5BB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
      </Grid>
    </local:GlassPanel>
    <WrapPanel Margin="0,16,0,0">
      <Button x:Name="JsonGuide" Content="JSON 规则填写说明" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
    </WrapPanel>
    <TextBlock Text="外部规则仅参与常规扫描和高级自选，清理前先备份。" Foreground="#A7BFCD" TextWrapping="Wrap" Margin="2,18,0,0" />
  </StackPanel>
</ScrollViewer>
</UserControl>