<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="澄净 · C 盘清理 · beta0.02 · by CraZyX" Width="1320" Height="900" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#F3F8F8" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#173E3D">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#708C8B"/>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#245A57"/><Setter Property="BorderBrush" Value="#D9E8E7"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.62"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="CheckSurface" Width="22" Height="22" CornerRadius="6" BorderThickness="1.5" BorderBrush="#9ABBB7" Background="White" VerticalAlignment="Center"><Path x:Name="CheckMark" Data="M 4,10 L 8,14 L 16,5" Stroke="#07534D" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#39C5BB"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#39C5BB"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckSurface" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#0C8F86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFEBEA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="#39C5BB"/><Setter TargetName="RowSurface" Property="Background" Value="#ECFAF8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="#39C5BB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E8E6"/><Setter Property="Foreground" Value="#3A6461"/></Style>
  <Style x:Key="Legend" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,13,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Background="#F3F8F8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#103C3B"><Grid Margin="20,28,16,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border Background="#39C5BB" Width="44" Height="44" CornerRadius="14" HorizontalAlignment="Left"><TextBlock Text="澄" Foreground="#0A4945" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="澄净" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,15,0,3"/><TextBlock Text="CLEAR SPACE" FontSize="10" Foreground="#8BCBC4"/><TextBlock Text="by CraZyX" FontSize="12" FontWeight="SemiBold" Foreground="#39C5BB" Margin="0,10,0,0"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,36,0,0"><Border Background="#205954" CornerRadius="10" Padding="12,12"><TextBlock Text="◉   C 盘清理" Foreground="#CBF5F0" FontWeight="SemiBold"/></Border><TextBlock Text="空间，由你掌控" Foreground="#9BCBC6" FontSize="11" Margin="5,16,0,0"/><TextBlock Text="先扫描&#x0a;看说明&#x0a;再清理" Foreground="#8CBBB5" LineHeight="34" Margin="5,17,0,0"/></StackPanel>
   <StackPanel Grid.Row="3"><Border Background="#1B504B" CornerRadius="11" Padding="11"><StackPanel><TextBlock Text="本地运行 · 不联网" Foreground="#BDE5DF" FontSize="10"/><TextBlock Text="个人资料保留" Foreground="#8DBBB4" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border><TextBlock x:Name="AccountText" Foreground="#91BFB8" FontSize="10" Margin="2,15,0,8" TextTrimming="CharacterEllipsis"/><Button x:Name="AdminButton" Content="以管理员身份重新打开" FontSize="10" Padding="7,9" Background="#245B54" Foreground="#CEF1E9" BorderThickness="0"/><TextBlock Text="1.1 / WINDOWS" Foreground="#75A8A0" FontSize="9" Margin="2,15,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="24,22,24,18">
   <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="118"/><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="MainTitleText" Text="给 C 盘留些呼吸空间" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="识别更多缓存与残留，每一项都有清楚的说明。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,3,0,0"><Button x:Name="ExportButton" Content="导出记录" IsEnabled="False" Margin="0,0,9,0" FontSize="12"/><Button x:Name="ScanButton" Content="开始扫描" FontSize="15" FontWeight="Bold" Padding="26,12" Background="#39C5BB" Foreground="#074B46" BorderThickness="0"/></StackPanel></Grid>
   <Border Grid.Row="1" Background="White" BorderBrush="#DFEBEA" BorderThickness="1" CornerRadius="17" Padding="20,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="70" Height="70" HorizontalAlignment="Left"><Ellipse Stroke="#E6F0EF" StrokeThickness="7"/><Path x:Name="DiskArc" Stroke="#39C5BB" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="C:" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="磁盘可用空间" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="DiskFreeText" Text="读取中" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock x:Name="DiskTotalText" Text="容量以当前电脑为准" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Grid>
    <StackPanel Grid.Column="1" Margin="25,0,0,0" VerticalAlignment="Center"><TextBlock Text="可处理合计 · 含需确认项目" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="FoundText" Text="待扫描" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock Text="已排除使用中与受保护的文件" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="25,0,0,0" VerticalAlignment="Center"><TextBlock Text="符合一键清理条件" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="QuickText" Text="待扫描" Foreground="#108D83" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock Text="低风险缓存 · 已过保留期" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
   </Grid></Border>
   <Grid Grid.Row="2" Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E1EFED" CornerRadius="11" Padding="4"><StackPanel Orientation="Horizontal"><Button x:Name="SimpleButton" Content="简洁 · 一键清理" Padding="18,9" Background="#39C5BB" Foreground="#073F3D" BorderThickness="0"/><Button x:Name="AdvancedButton" Content="高级 · 自选清理" Padding="18,9" Background="Transparent" BorderThickness="0"/></StackPanel></Border><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SelectVisibleButton" Content="选当前列表" Padding="10,8" FontSize="11" Margin="0,0,7,0" Visibility="Collapsed"/><Button x:Name="RecommendButton" Content="只选低风险" Padding="10,8" FontSize="11" Margin="0,0,7,0" Visibility="Collapsed"/><Button x:Name="UnselectButton" Content="清空选择" Padding="10,8" FontSize="11" Visibility="Collapsed"/><TextBlock x:Name="SimpleHint" Text="更多项目与风险说明可在高级模式查看" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel></Grid>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="286"/></Grid.ColumnDefinitions>
    <Border x:Name="WelcomePanel" Background="White" BorderBrush="#DFEBEA" BorderThickness="1" CornerRadius="16" Padding="18,16"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="准备好了，再开始" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="启动不会自动扫描，也不会删除文件。" TextWrapping="Wrap" Foreground="#6E8B87" FontSize="11" Margin="0,7,10,0"/></StackPanel><Button x:Name="StartButton" Grid.Column="1" Content="开始扫描  →" Background="#39C5BB" Foreground="#084C45" BorderThickness="0" FontSize="16" FontWeight="Bold" Padding="25,15" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
     <DockPanel Margin="0,0,0,8"><TextBlock Text="扫描范围" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="  勾选要检查的分类" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
     <ItemsControl x:Name="ScopeList" Margin="-4,0,-4,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="4" Padding="11,12" Background="#F3F9F8" BorderBrush="#E0EDEB" BorderThickness="1" CornerRadius="11"><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Description}" Foreground="#718F88" FontSize="10" TextWrapping="Wrap" Margin="0,5,2,0" LineHeight="16"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#269F93" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4,1,0,0"/></Grid></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="分类勾选只决定扫描范围，不代表同意删除。" Foreground="#6A8A85" FontSize="10" Margin="4,11,0,0" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer></Border>
    <Grid x:Name="ResultsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="46"/><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ResultTitle" Text="识别结果" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="CountText" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="6,0,12,0"/><Button x:Name="ScopeButton" Grid.Column="2" Content="扫描范围" FontSize="10" Padding="9,5" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="1" Margin="0,5,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="166"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="CategoryFilter" Margin="0,0,7,0"/><ComboBox x:Name="RiskFilter" Grid.Column="1" Margin="0,0,7,0"/><Border Grid.Column="2" CornerRadius="7" Background="White" BorderThickness="1" BorderBrush="#D7E8E6" Padding="8,0"><Grid><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="11" Padding="0,6" VerticalContentAlignment="Center"/><TextBlock Text="搜索项目…" Foreground="#92AAA5" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></Grid>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,0,5"><TextBlock Text="● 低风险" Foreground="#138A7F" Style="{StaticResource Legend}"/><TextBlock Text="● 有风险 / 需确认" Foreground="#AE771E" Style="{StaticResource Legend}"/><TextBlock Text="● 使用痕迹" Foreground="#B65370" Style="{StaticResource Legend}"/><TextBlock Text="● 仅展示" Foreground="#507BA4" Style="{StaticResource Legend}"/></StackPanel>
     <ListBox x:Name="ResultsList" Grid.Row="3" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><Grid Margin="13,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" IsEnabled="{Binding Selectable}" Visibility="{Binding CheckVisibility}" Width="25" Margin="0,0,11,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Border Background="{Binding StatusBackground}" CornerRadius="5" Padding="6,3"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="10"/></Border><TextBlock Text="{Binding Category}" Foreground="#879B96" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="130"><TextBlock Text="{Binding EligibleLabel}" Foreground="{Binding ActionBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Size}" Foreground="#7D9690" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/><TextBlock Text="{Binding ActionReason}" Foreground="#7D9690" FontSize="9" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock x:Name="EmptyText" Grid.Row="3" Text="尚未扫描" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22" Visibility="Collapsed"/>
    </Grid>
    <Border Grid.Column="2" Background="#EAF5F2" BorderBrush="#D9EBE5" BorderThickness="1" CornerRadius="16" Padding="19,18"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Border x:Name="DetailBadge" Background="#D5F1E9" CornerRadius="7" HorizontalAlignment="Left" Padding="9,5"><TextBlock x:Name="DetailTag" Text="操作由你决定" Foreground="#157F73" FontSize="11" FontWeight="SemiBold"/></Border>
     <TextBlock x:Name="DetailTitle" Text="先扫描，再选择" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,10" TextWrapping="Wrap"/>
     <Border Background="#FFFFFF" CornerRadius="10" Padding="12,12" Margin="0,0,0,14"><TextBlock x:Name="DetailAction" Text="扫描不会删除文件" Foreground="#12887D" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/></Border>
     <TextBlock x:Name="DetailDescription" Foreground="#597A71" FontSize="11" TextWrapping="Wrap" LineHeight="21"/>
     <TextBlock Text="清理后的影响" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,7"/><TextBlock x:Name="DetailImpact" Foreground="#597A71" FontSize="11" TextWrapping="Wrap" LineHeight="21"/>
     <TextBlock x:Name="DetailRetention" Foreground="#52776A" FontSize="10" TextWrapping="Wrap" LineHeight="19" Margin="0,16,0,0"/>
     <TextBlock Text="文件位置 / 检查信息" FontWeight="SemiBold" FontSize="12" Margin="0,17,0,7"/><TextBox x:Name="DetailPaths" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#6A8980" FontSize="10" Padding="0"/>
     <Button x:Name="OpenFolderButton" Content="打开文件位置 ↗" HorizontalAlignment="Left" Margin="0,13,0,0" Padding="10,8" FontSize="10" IsEnabled="False"/>
    </StackPanel></ScrollViewer></Border>
   </Grid>
   <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="*"/></Grid.RowDefinitions><ProgressBar x:Name="Progress" Height="3" Foreground="#39C5BB" Background="#E1EEEA" BorderThickness="0" Visibility="Collapsed"/>
    <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="StatusText" Text="尚未扫描。选择分类，点击开始扫描。" FontSize="11" Foreground="#4C7168" TextWrapping="Wrap"/><TextBlock x:Name="SelectionText" Foreground="#7A958A" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
     <TextBlock x:Name="PlannedText" Grid.Column="1" Text="可处理 0 B" FontSize="19" FontWeight="Bold" Foreground="#0D857A" VerticalAlignment="Center" Margin="12,0,17,0"/>
     <Button x:Name="CancelButton" Grid.Column="2" Content="停止" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center"/>
     <Button x:Name="CleanButton" Grid.Column="3" Content="一键清理低风险缓存" Background="#39C5BB" Foreground="#084E46" BorderThickness="0" FontWeight="Bold" FontSize="14" Padding="23,14" VerticalAlignment="Center" IsEnabled="False"/>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
