<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="澄净 · C 盘清理 · beta0.01 · by CraZyX" Width="1280" Height="840" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F7F6" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#18342D">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#74867E"/>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,10"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#234D40"/><Setter Property="BorderBrush" Value="#DBE5DF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3EAE6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="#25936C"/><Setter TargetName="RowSurface" Property="Background" Value="#F0F8F3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="#91B8A5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#F5F7F6">
  <Grid.ColumnDefinitions><ColumnDefinition Width="186"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142D26"><Grid Margin="22,30,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border Background="#62D69D" Width="42" Height="42" CornerRadius="13" HorizontalAlignment="Left"><TextBlock Text="澄" Foreground="#14372A" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="澄净" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,15,0,2"/><TextBlock Text="CLEAR SPACE" FontSize="10" Foreground="#94BAA6"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,52,0,0"><Border Background="#294A3B" CornerRadius="10" Padding="13,12"><TextBlock Text="◉   C 盘清理" Foreground="#D1F5DF" FontWeight="SemiBold"/></Border><TextBlock Text="让空间回到有用的地方" Foreground="#9CB9AA" FontSize="11" Margin="6,16,0,0"/><TextBlock Text="缓存识别&#x0a;逐项说明&#x0a;清理记录" Foreground="#97B3A4" LineHeight="33" Margin="6,19,0,0"/></StackPanel>
   <StackPanel Grid.Row="3"><Border Background="#203C30" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="本地运行 · 不联网" Foreground="#C6E7D3" FontSize="11"/><TextBlock Text="个人文件始终保留" Foreground="#8EAFA0" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><TextBlock x:Name="AccountText" Foreground="#88A897" FontSize="10" Margin="3,16,0,7" TextTrimming="CharacterEllipsis"/><Button x:Name="AdminButton" Content="以管理员身份重新打开" FontSize="10" Padding="8,8" Background="#244737" Foreground="#C3E4CF" BorderThickness="0"/><TextBlock Text="1.0  /  WINDOWS" Foreground="#719580" FontSize="9" Margin="3,16,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="30,24,30,20"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="136"/><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="MainTitleText" Text="给 C 盘留些呼吸空间" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="自动发现缓存与残留，清理之前先看清楚。" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,0,0"><Button x:Name="ExportButton" Content="导出记录" Margin="0,0,9,0" IsEnabled="False"/><Button x:Name="ScanButton" Content="重新扫描" Background="#183F2F" Foreground="White" BorderThickness="0"/></StackPanel></Grid>
   <Border Grid.Row="1" Background="White" BorderBrush="#E1E9E3" BorderThickness="1" CornerRadius="17" Padding="22,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="70" Height="70" HorizontalAlignment="Left"><Ellipse Stroke="#E4ECE6" StrokeThickness="7"/><Path x:Name="DiskArc" Stroke="#258A63" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="C:" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="磁盘可用空间" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="DiskFreeText" Text="读取中" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,3"/><TextBlock x:Name="DiskTotalText" Text="容量以当前电脑为准" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Grid>
    <StackPanel Grid.Column="1" Margin="25,0,0,0" VerticalAlignment="Center"><TextBlock Text="识别到的清理候选" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="FoundText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,1"/><TextBlock Text="含需确认项目，不含受保护资料" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="25,0,0,0" VerticalAlignment="Center"><TextBlock Text="符合一键清理条件" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="QuickText" Text="—" Foreground="#21865F" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,1"/><TextBlock Text="程序已关闭 · 文件已过保留期" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
   </Grid></Border>
   <Grid Grid.Row="2" Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E7EEE8" CornerRadius="11" Padding="4"><StackPanel Orientation="Horizontal"><Button x:Name="SimpleButton" Content="简洁 · 一键清理" Padding="20,10" Background="White" BorderThickness="0"/><Button x:Name="AdvancedButton" Content="高级 · 自选清理" Padding="20,10" Background="Transparent" Foreground="#6D8076" BorderThickness="0"/></StackPanel></Border><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="RecommendButton" Content="只选推荐" Padding="12,8" FontSize="11" Margin="0,0,8,0" Visibility="Collapsed"/><Button x:Name="UnselectButton" Content="清空选择" Padding="12,8" FontSize="11" Visibility="Collapsed"/><TextBlock x:Name="SimpleHint" Text="需确认的项目可在高级模式查看" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel></Grid>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock x:Name="ResultTitle" Text="正在识别可清理项目" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel><ListBox x:Name="ResultsList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><Grid Margin="14,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" IsEnabled="{Binding Selectable}" Visibility="{Binding CheckVisibility}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Category}" Foreground="#839389" FontSize="10" Margin="0,0,9,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="10"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Size}" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding EligibleLabel}" Foreground="#839389" FontSize="9" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyText" Grid.Row="1" Text="尚未扫描" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25" Visibility="Collapsed"/></Grid>
    <Border Grid.Column="2" Background="#EDF3EE" CornerRadius="15" Padding="21,20"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Border Background="#D8EADC" CornerRadius="7" HorizontalAlignment="Left" Padding="10,5"><TextBlock x:Name="DetailTag" Text="清理说明" Foreground="#347153" FontSize="10"/></Border><TextBlock x:Name="DetailTitle" Text="清理得轻松，也清楚" FontSize="19" FontWeight="SemiBold" Margin="0,15,0,12" TextWrapping="Wrap"/><TextBlock x:Name="DetailDescription" Text="一键清理只处理已知、可重新生成的缓存。先关闭相关程序，最近修改或被占用的文件会自动保留。" Foreground="#587061" FontSize="12" TextWrapping="Wrap" LineHeight="22"/><TextBlock Text="清理后的影响" FontWeight="SemiBold" FontSize="12" Margin="0,21,0,8"/><TextBlock x:Name="DetailImpact" Text="设置、密码、聊天记录、已安装扩展、文档和未保存文件备份都不在一键清理范围内。" Foreground="#587061" FontSize="12" TextWrapping="Wrap" LineHeight="21"/><TextBlock x:Name="DetailRetention" Foreground="#547160" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0"/><TextBlock Text="文件位置" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,7"/><TextBox x:Name="DetailPaths" Text="点击左侧项目，查看目录和详细说明。" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#6B8172" FontSize="10" Padding="0"/><Button x:Name="OpenFolderButton" Content="打开文件位置 ↗" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,8" FontSize="11" IsEnabled="False"/></StackPanel></ScrollViewer></Border>
   </Grid>
   <Grid Grid.Row="4" Margin="0,17,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ProgressBar x:Name="Progress" Height="3" Foreground="#29966B" Background="#E2EAE4" BorderThickness="0" Visibility="Collapsed"/><Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="只读扫描，不会自动删除文件。" FontSize="12" Foreground="#536D5E" TextWrapping="Wrap"/><TextBlock x:Name="SelectionText" Text="正在读取当前电脑的缓存目录" Foreground="#85968B" FontSize="10" Margin="0,5,0,0"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="停止" Margin="10,0,10,0" Visibility="Collapsed" VerticalAlignment="Center"/><Button x:Name="CleanButton" Grid.Column="2" Content="一键清理" Background="#20875E" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="14" Padding="28,13" VerticalAlignment="Center" IsEnabled="False"/></Grid></Grid>
  </Grid>
 </Grid>
</Window>
